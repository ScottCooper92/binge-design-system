    <!--
      Floor for either pane when a two-pane split snaps to a foldable's hinge (#819). A fold near the
      window edge would otherwise hand one side a sliver; below this the split ignores the hinge and
      keeps its default width, which is what every non-foldable window does anyway.
    -->
    <dimen name="two_pane_min_width">280dp</dimen>
    <!--
      Floor for the space below a tabletop fold before a bottom-anchored surface will cap itself to it
      (#819). Below this the crease is close enough to the bottom edge that honouring it would leave a
      sheet too short to use, so it is ignored and the sheet keeps its own height.
    -->
    <dimen name="fold_safe_bottom_min_height">200dp</dimen>
    <dimen name="account_stat_padding_h">10dp</dimen>
