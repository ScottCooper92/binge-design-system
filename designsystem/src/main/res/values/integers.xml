<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Columns for a poster/media grid, keyed on available window width (see mediaGridColumns()).
         Compact default; values-w600dp/values-w840dp widen it. -->
    <integer name="media_grid_columns">2</integer>
    <!-- Columns for the search results grid, keyed on available window width (see searchResultColumns()).
         A search result is a ListRow, not a poster, so it wants a wider cell than media_grid_columns
         gives: one column on a phone, widening only where a row would otherwise run the full window. -->
    <integer name="search_result_columns">1</integer>
</resources>
