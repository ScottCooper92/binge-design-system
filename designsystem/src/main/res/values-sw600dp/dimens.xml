<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Tablets (smallest-width >=600dp) are tall enough for the cinematic hero to breathe:
         lift it to the taller standard value. The expanded/"tall" treatment is the tablet default
         (see issue #770); landscape phones never reach this bucket and keep the computed compact cap. -->
    <dimen name="hero_height">446dp</dimen>
    <!-- The cast row scales with the same width that earns the taller hero: an 80dp face sized for a
         phone reads as a row of thumbnails on a tablet, where the carousel has width to spare and the
         faces are what the section is for. The detail skeleton's plates follow it. -->
    <dimen name="cast_avatar_size">112dp</dimen>
    <dimen name="person_card_compact_width">128dp</dimen>

    <!-- Tablet override of the shared episode list's still (the base is 144dp). The row keeps the 640dp reading measure, so the extra
         width goes to the still, and 200dp at the backdrop aspect ratio leaves the synopsis its four lines below. -->
    <dimen name="episode_browse_row_still_width" tools:ignore="MissingDefaultResource">200dp</dimen>
</resources>
