{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Routine dependency version updates only. Security is handled by GitHub's own Dependabot, so
  // vulnerabilityAlerts is disabled here to avoid two bots opening a PR for the same CVE.
  extends: [
    "config:recommended",
    "helpers:pinGitHubActionDigests", // action bumps keep the `# vX.Y.Z` SHA form
    ":dependencyDashboard",
  ],

  vulnerabilityAlerts: { enabled: false },

  labels: ["dependencies"],
  rebaseWhen: "conflicted",
  prConcurrentLimit: 4,
  schedule: ["before 6am on monday"],

  // Let an immediately-yanked or broken release wash out before it reaches a PR.
  minimumReleaseAge: "3 days",

  // Auto-merge waits for all branch checks. A bump that shifts rendering fails
  // validateDebugScreenshotTest and never auto-merges.
  platformAutomerge: true,

  // This repository has no submodules; kept off so the file stays safe to copy.
  "git-submodules": { enabled: false },

  packageRules: [
    {
      // Patch-level only, and only for actions and libraries that cannot change a rendered pixel.
      // The toolchain rules below come later and override this.
      matchUpdateTypes: ["patch"],
      automerge: true,
    },
    {
      // Compose, Kotlin and KSP must agree with the consumers' versions, and a rendering
      // shift needs a human to decide on the re-record. Never auto-merge, even on a patch.
      matchPackageNames: [
        "/^org\\.jetbrains\\.kotlin[.:]/",
        "/^com\\.google\\.devtools\\.ksp/",
        "/^androidx\\.compose\\./",
      ],
      groupName: "compose + kotlin toolchain",
      automerge: false,
      prBodyNotes: [
        "**Needs matching bumps in `Binge`, `binge-seerr`, `binge-archive` and `binge-jellyfin`.** The root `libs.versions.toml` is not a local decision: Compose, Kotlin and KSP versions have to agree with the consumers'. A rendering shift fails `validateDebugScreenshotTest`; the re-record is a human decision.",
      ],
    },
    {
      // AGP is its own PR. Gradle refuses two AGP versions in one build, so a bump here breaks every consumer's
      // `consumer-check` until each one moves too, and it has to land in lockstep with all four of them. It must not
      // wait behind, or be blocked by, a Compose bump that needs a decision of its own.
      matchPackageNames: ["/^com\\.android\\.(tools\\.build|application|library)/"],
      groupName: "android gradle plugin",
      automerge: false,
      prBodyNotes: [
        "**Moves in lockstep with `Binge`, `binge-seerr`, `binge-archive` and `binge-jellyfin`.** Gradle rejects two AGP versions in one build, so the consumers' `consumer-check` stays red until each one bumps `agp` to the same version in its own catalog. Merge this together with those bumps, not before.",
      ],
    },
    {
      // material3 is pinned ahead of the BOM on an alpha, because the expressive theme reads APIs the BOM's stable line
      // lacks. Its beta and rc lines are not taken until a Compose 1.13 BOM ships (#774); alphas and the stable release
      // still are. The alpha line pulls the Compose UI line forward to 1.13, which the test fixtures rely on for
      // `ComposeUiTestConfig`; an rc resolves back to the BOM's 1.12 and breaks them.
      matchPackageNames: [
        "androidx.compose.material3:material3",
        "androidx.compose.material3:material3-adaptive-navigation-suite",
      ],
      allowedVersions: "!/-(beta|rc)/",
    },
  ],
}
