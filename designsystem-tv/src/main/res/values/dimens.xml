<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- TV dp tokens. Screenshot previews are driven by device specs rather than uiMode, so these live in the
         base values and take no television qualifier. -->
    <!-- Overscan and the content gutter -->
    <dimen name="tv_overscan_horizontal">48dp</dimen>
    <dimen name="tv_overscan_vertical">27dp</dimen>
    <dimen name="tv_content_gutter_start">24dp</dimen>
    <!-- Focus ring -->
    <dimen name="tv_focus_ring_width">3dp</dimen>
    <dimen name="tv_focus_ring_offset">4dp</dimen>
    <dimen name="tv_focus_ring_bleed">12dp</dimen>
    <!-- Navigation rail -->
    <dimen name="tv_nav_rail_collapsed_width">72dp</dimen>
    <dimen name="tv_nav_rail_expanded_width">220dp</dimen>
    <dimen name="tv_nav_rail_padding">10dp</dimen>
    <dimen name="tv_nav_rail_item_height">44dp</dimen>
    <dimen name="tv_nav_rail_item_padding_h">14dp</dimen>
    <dimen name="tv_nav_rail_item_gap">8dp</dimen>
    <dimen name="tv_nav_rail_icon_label_gap">14dp</dimen>
    <dimen name="tv_nav_rail_avatar_size">32dp</dimen>
    <dimen name="tv_nav_rail_badge_size">16dp</dimen>
    <dimen name="tv_nav_rail_badge_padding_h">4dp</dimen>
    <dimen name="tv_nav_rail_badge_offset">4dp</dimen>
    <dimen name="tv_nav_rail_scrim_falloff">20dp</dimen>
    <!-- Button -->
    <dimen name="tv_button_height">52dp</dimen>
    <dimen name="tv_button_padding_horizontal">28dp</dimen>
    <dimen name="tv_button_icon">22dp</dimen>
    <dimen name="tv_button_icon_gap">10dp</dimen>
    <dimen name="tv_button_border_width">1dp</dimen>
    <!-- Icon button: diameter matches tv_button_height so it aligns with a TvButton in the same row; the
         horizontal padding is exactly (diameter - tv_button_icon) / 2, so the icon alone fills the circle
         with no slack at rest. -->
    <dimen name="tv_icon_button_diameter">52dp</dimen>
    <dimen name="tv_icon_button_padding_horizontal">15dp</dimen>
    <!-- Card row -->
    <dimen name="tv_media_row_header_gap">10dp</dimen>
    <dimen name="tv_media_row_card_gap">12dp</dimen>
    <!-- Selected tick -->
    <dimen name="tv_selected_tick_size">24dp</dimen>
    <dimen name="tv_selected_tick_glyph_size">16dp</dimen>
    <!-- Message plate and illustration -->
    <dimen name="tv_message_plate_max_width">520dp</dimen>
    <dimen name="tv_illustration_plate">128dp</dimen>
    <dimen name="tv_illustration_icon">64dp</dimen>
</resources>
