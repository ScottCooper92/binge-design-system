    <dimen name="tv_side_sheet_chevron_size">24dp</dimen>
    <dimen name="tv_confirm_dialog_width">560dp</dimen>
    <!-- List rows in the tv-material ListItem form: a list-and-pane board's column, the options in its pane, and the
         rows' own marks. tv_list_item_height mirrors ListItem's one-line minimum height, which the library keeps
         private, so a skeleton can reserve a row's footprint. -->
    <dimen name="tv_list_item_height">48dp</dimen>
    <!-- The same minimum with a supporting line under the headline -->
    <dimen name="tv_list_item_two_line_height">64dp</dimen>
    <dimen name="tv_list_pane_row_gap">2dp</dimen>
    <!-- ListItem's own start padding, so a group header lines up with the labels under it -->
    <dimen name="tv_list_pane_row_padding_horizontal">16dp</dimen>
    <dimen name="tv_list_pane_group_gap">12dp</dimen>
    <dimen name="tv_list_pane_header_bottom_gap">8dp</dimen>
    <!-- A group header's labelMedium line, which the skeleton's header plate stands in for -->
    <dimen name="tv_list_pane_group_header_height">16dp</dimen>
    <dimen name="tv_list_pane_option_width">280dp</dimen>
    <!-- A list row's leading icon, plain in the row's content colour: no plate, so it costs the label as little width as it can -->
    <dimen name="tv_list_pane_row_icon">24dp</dimen>
    <!-- The slot ListItem gives leading content, in which the icon sits centred, then the gap after the slot; and a row
         with an icon's height. The label starts 56dp in: 16dp padding, the 32dp slot and the 8dp gap. -->
    <dimen name="tv_list_pane_row_icon_slot">32dp</dimen>
    <dimen name="tv_list_pane_row_icon_gap">8dp</dimen>
    <dimen name="tv_list_item_icon_height">56dp</dimen>
    <!-- A list row's trailing spinner while its value loads, and the arc's stroke at that size -->
    <dimen name="tv_list_pane_row_spinner">20dp</dimen>
    <dimen name="tv_list_pane_row_spinner_stroke">2.5dp</dimen>
    <dimen name="tv_list_pane_skeleton_line_height">28dp</dimen>
    <!-- A row's supporting line, which the skeleton's second bar stands in for -->
    <dimen name="tv_list_pane_skeleton_detail_height">16dp</dimen>
    <!-- A group note's bar: no taller than a line of the note's own style, so the line sets the height. -->
    <dimen name="tv_list_pane_skeleton_note_height">12dp</dimen>
    <dimen name="tv_option_row_gap">7dp</dimen>
    <!-- A row's leading icon plate: the tinted box behind the glyph, which is tv_button_icon -->
    <dimen name="tv_row_icon_plate">40dp</dimen>
    <dimen name="tv_checkbox_size">28dp</dimen>
    <dimen name="tv_checkbox_border">2dp</dimen>
    <!-- Pill choices and tabs: the label's inset in its pill, and the floor width of a tab's count -->
    <dimen name="tv_choice_padding_horizontal">20dp</dimen>
    <dimen name="tv_tab_count_min_width">28dp</dimen>
    <!-- The rating stepper: one star glyph of the read-out, and the gap between them -->
    <dimen name="tv_rating_stepper_star_size">32dp</dimen>
    <dimen name="tv_rating_stepper_star_gap">4dp</dimen>
    <!-- The room a side sheet leaves a stepper: its width less the start padding and the end overscan margin -->
    <dimen name="tv_rating_stepper_sheet_room">308dp</dimen>
    <!-- TvNumberStepper: the chevron either side of the number, dimmed at that end of the range. -->
    <dimen name="tv_number_stepper_chevron_size">32dp</dimen>
    <!-- The save status line: its glyph, at the button icon's size so the line matches the Retry beside it -->
    <dimen name="tv_save_status_icon">22dp</dimen>
    <dimen name="tv_save_status_narrow_sample_width">280dp</dimen>
    <!-- The full-screen reader: the still on the left with the title and text beside it, inset from the start edge and
         capped to a readable measure. The poster sits beside the copy column, not above it, so its width only sets how
         much horizontal room the text gets: 140dp (210dp tall at 2:3) reads as a poster without crowding the measure. -->
    <dimen name="tv_overview_content_inset">80dp</dimen>
    <dimen name="tv_overview_backdrop_width">300dp</dimen>
    <dimen name="tv_overview_poster_width">140dp</dimen>
    <dimen name="tv_overview_text_max_width">760dp</dimen>
    <!-- TvSideSheetNote's leading glyph, sized to the bodyMedium line it leads. -->
    <dimen name="tv_side_sheet_note_icon_size">18dp</dimen>
</resources>
